# ====================================================
# GEREPLY
# ====================================================
APP_BASE_URL=https://gereply.vercel.app
PORT=3001
NODE_ENV=development
TRUST_PROXY=true

# ====================================================
# GOOGLE OAUTH
# ====================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
SESSION_SECRET=

# ====================================================
# GEMINI (SERVER-SIDE ONLY)
# ====================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_SUPPORTED_LANGUAGES=English,Malayalam

# ====================================================
# META (SERVER-SIDE)
# ====================================================
WHATSAPP_PROVIDER=mock
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v21.0
META_SYSTEM_USER_ACCESS_TOKEN=

# ====================================================
# REQUEST AND DATABASE CONFIGURATION
# ====================================================
CORS_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=256kb
WHATSAPP_WEBHOOK_RATE_LIMIT=240
DATABASE_URL=

# ====================================================
# FRONTEND (PUBLIC BUILD-TIME VALUES ONLY)
# ====================================================
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_API_URL=
