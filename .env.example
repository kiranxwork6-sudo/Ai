# ====================================================
# SERVER CONFIGURATION
# ====================================================
PORT=3001
NODE_ENV=development

# Trust proxy headers when behind Vercel or reverse proxy (set to 'true' for production)
TRUST_PROXY=true

# ====================================================
# GOOGLE OAUTH AUTHENTICATION
# ====================================================
# Required for Google sign-in. Generate credentials at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth callback URL (must match Google Console exactly)
# Local: http://localhost:3001/api/auth/google/callback
# Production: https://YOUR-DOMAIN.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ====================================================
# SESSION SECURITY
# ====================================================
# Required: Generate a strong random secret (e.g., openssl rand -base64 48)
# NEVER commit real secrets to git
SESSION_SECRET=

# ====================================================
# AI MODEL CONFIGURATION (Server-side only)
# ====================================================
# IMPORTANT: Never prefix these with VITE_ (they must remain server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_SUPPORTED_LANGUAGES=English,Malayalam

# ====================================================
# WHATSAPP CONFIGURATION
# ====================================================
# Set to 'mock' for local testing/sandbox (no Meta credentials needed)
# Set to 'meta' for production Meta WhatsApp Business Cloud API
WHATSAPP_PROVIDER=mock

# ====================================================
# CORS & REQUEST LIMITS
# ====================================================
# Comma-separated list of allowed origins for CORS
# Local dev: http://localhost:5173
# Production: https://YOUR-FRONTEND-DOMAIN.vercel.app
CORS_ORIGIN=http://localhost:5173

JSON_BODY_LIMIT=256kb
WHATSAPP_WEBHOOK_RATE_LIMIT=240

# ====================================================
# META WHATSAPP CLOUD API CREDENTIALS
# ====================================================
# Meta App ID (public, can be used client-side)
META_APP_ID=230831096602291

# Meta App Secret (NEVER expose client-side)
META_APP_SECRET=

# Meta Embedded Signup Config ID (public, used for Embedded Signup flow)
META_EMBEDDED_SIGNUP_CONFIG_ID=1737194977391820

# Meta Embedded Signup Redirect URI (must match Meta App settings)
# Production: https://gereply.vercel.app
META_EMBEDDED_SIGNUP_REDIRECT_URI=https://gereply.vercel.app

# Meta Graph API version
META_GRAPH_API_VERSION=v21.0

# Webhook verification token (set in Meta App Dashboard)
META_VERIFY_TOKEN=

# Legacy/fallback credentials (for direct credential entry, not Embedded Signup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ====================================================
# DATABASE (PostgreSQL/Production)
# ====================================================
# Required for persistent production data storage
# The current file-based storage (data/db.json) is NOT production-ready
# Recommended: Supabase, Neon, or Vercel Postgres
DATABASE_URL=

# ====================================================
# FRONTEND CONFIGURATION (Vite)
# ====================================================
# Optional: API base URL for frontend API calls
# Leave empty for same-origin deployments (frontend and backend on same domain)
# Set to backend URL for separate deployments (e.g., https://your-api.vercel.app)
# VITE_API_URL=
