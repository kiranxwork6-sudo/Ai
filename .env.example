# Server Configuration
PORT=3001
NODE_ENV=development

# AI Model Configuration (Optional: if empty, built-in receptionist knowledge engine runs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# WhatsApp Provider Configuration
# Set to 'mock' for sandbox/testing without Meta credentials
# Set to 'meta' for the official WhatsApp Business Cloud API
WHATSAPP_PROVIDER=mock

# Official Meta WhatsApp Cloud API Credentials (Required only if WHATSAPP_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=ai_receptionist_secure_verify_token
WHATSAPP_APP_SECRET=
